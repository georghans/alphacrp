// ─── Logs: Docker container discovery → Grafana Cloud Loki ───

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_labels" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_labels.output
  forward_to = [loki.process.filter.receiver]
}

loki.process "filter" {
  forward_to = [loki.write.grafana_cloud.receiver]

  stage.drop {
    expression = "^\\s*$"
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_LOKI_URL")

    basic_auth {
      username = env("GRAFANA_LOKI_USERNAME")
      password = env("GRAFANA_LOKI_API_KEY")
    }
  }
}

// ─── Host metrics: node_exporter equivalent ───

prometheus.exporter.unix "host" {}

prometheus.scrape "host_metrics" {
  targets    = prometheus.exporter.unix.host.targets
  scrape_interval = "60s"
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// ─── Container metrics: cAdvisor ───

prometheus.scrape "cadvisor" {
  targets = [{
    __address__ = "cadvisor:8080",
  }]
  scrape_interval = "60s"
  metrics_path    = "/metrics"
  forward_to      = [prometheus.relabel.cadvisor_filter.receiver]
}

prometheus.relabel "cadvisor_filter" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "container_cpu_usage_seconds_total|container_memory_usage_bytes|container_memory_working_set_bytes|container_network_receive_bytes_total|container_network_transmit_bytes_total|container_fs_usage_bytes|container_fs_limit_bytes"
    action        = "keep"
  }
}

// ─── Remote write: all metrics → Grafana Cloud Prometheus ───

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_PROMETHEUS_URL")

    basic_auth {
      username = env("GRAFANA_PROMETHEUS_USERNAME")
      password = env("GRAFANA_PROMETHEUS_API_KEY")
    }
  }
}
